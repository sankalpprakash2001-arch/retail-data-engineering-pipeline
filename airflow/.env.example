# Copy to .env in this directory. Never commit .env.
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=change_me_local_password
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_SECRET_KEY=replace_with_a_long_random_value

# Databricks workspace and ingestion job used by the Airflow DAG
DATABRICKS_HOST=https://<your-workspace-host>
DATABRICKS_TOKEN=<your-databricks-token>
DATABRICKS_JOB_ID=<your-databricks-job-id>
DATABRICKS_HTTP_PATH=<your-sql-warehouse-http-path>
DATABRICKS_CATALOG=walmart
DATABRICKS_SCHEMA=dbt_schema
